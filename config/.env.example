# ── OpenStack Credentials ──────────────────────────────────────────────────
OS_AUTH_URL=https://keystone.your-cloud.example.com:5000/v3
OS_USERNAME=ai-agent-svc
OS_PASSWORD=change-me
OS_PROJECT_NAME=admin
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default
OS_REGION_NAME=RegionOne

# ── LLM Provider ───────────────────────────────────────────────────────────
# Pick one: anthropic | openrouter | ollama
LLM_PROVIDER=anthropic

# Model id — interpretation depends on provider:
#   anthropic  : claude-haiku-4-5-20251001, claude-sonnet-4-6, claude-opus-4-7
#   openrouter : meta-llama/llama-3.3-70b-instruct:free, qwen/qwen-2.5-72b-instruct:free
#   ollama     : llama3.1:8b, qwen2.5:14b
# If unset, falls back to CLAUDE_MODEL below.
LLM_MODEL=claude-haiku-4-5-20251001

# Anthropic (provider=anthropic) — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# OpenRouter (provider=openrouter) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama (provider=ollama) — local server URL
# Install: brew install ollama && ollama serve && ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ── Monitoring ─────────────────────────────────────────────────────────────
PROMETHEUS_URL=http://prometheus.monitoring.svc:9090
OPENSEARCH_URL=https://opensearch.your-cloud.example.com:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=change-me

# ── Vector DB (Qdrant) ─────────────────────────────────────────────────────
QDRANT_URL=http://qdrant.your-cloud.example.com:6333
QDRANT_COLLECTION=openstack_knowledge

# ── Agent Safety ───────────────────────────────────────────────────────────
# Set to true to disable ALL writes — safe for testing
AGENT_DRY_RUN=false

# Actions that require explicit human approval before execution
# Comma-separated list of action names
APPROVAL_REQUIRED=delete_instance,delete_volume,delete_network,resize_cluster,reboot_hypervisor

# Maximum instances a single agent action can touch at once
AGENT_MAX_BATCH_SIZE=10

# ── API Server ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
API_SECRET_KEY=change-me-to-a-strong-random-secret

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
AUDIT_LOG_PATH=/var/log/openstack-agent/audit.log
